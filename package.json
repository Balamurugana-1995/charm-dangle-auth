{
  "name": "charm-dangle-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "A little lucky charm that hangs from the top of your screen.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.charmdangle.app",
    "productName": "Charm Dangle",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "icon.png",
      "icon16.png",
      "icon32.png"
    ],
    "mac": {
      "icon": "icon.png",
      "target": "dmg",
      "category": "public.app-category.lifestyle"
    },
    "win": {
      "icon": "icon.png",
      "target": "nsis"
    },
    "linux": {
      "icon": "icon.png",
      "target": "AppImage"
    }
  }
}
